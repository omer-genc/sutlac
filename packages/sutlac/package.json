{
  "name": "sutlac",
  "version": "0.1.2",
  "description": "Issue tracking in your repo's docs/ folder: local UI, CLI and Claude Code skills to open, start, hand out, collect and close tasks.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omer-genc/sutlac.git",
    "directory": "packages/sutlac"
  },
  "bin": {
    "sutlac": "src/cli.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "dist",
    "skills",
    "hooks",
    "templates",
    ".claude-plugin"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun src/dev.ts",
    "build": "bun build.ts",
    "start": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@happy-dom/global-registrator": "20.0.0",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.102.2",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-code": "3.30.5",
    "@tiptap/extension-hard-break": "3.30.5",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extension-list": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/extension-text": "3.30.5",
    "@tiptap/extensions": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@types/bun": "^1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tiptap-markdown": "0.9.0",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.3"
  }
}
